# Billing Copilot. Copy to .env; never commit real credentials.
# Demo: local, offline extractive replies. Live: PostgreSQL + configured AI.
APP_MODE=demo
APP_ENV=development
WORKSPACE_NAME=Billing workspace
RATE_LIMIT_PER_MINUTE=60

# Required for live mode or APP_ENV=production. Use unique random keys >=24 characters.
# Replace the example values before use. Admins manage shared documents; agents query.
# RELAY_API_KEYS='{"owner":{"key":"REPLACE_WITH_A_RANDOM_SECRET","role":"admin"},"agent":{"key":"REPLACE_WITH_ANOTHER_SECRET","role":"agent"}}'
RELAY_API_KEYS={}

# Live answer provider: ollama | openai | groq
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=

# Live embedding provider: local | ollama | openai
# Supplied database schema is vector(384). Model and schema dimensions must match.
# Changing embedding models requires re-indexing every document.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# nomic-embed-text typically emits 768 dimensions; migrate schema before selecting it.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# PostgreSQL with pgvector (live mode only).
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vector_db
# DATABASE_URL=postgresql://user:password@host:5432/database
