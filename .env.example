# ──────────────────────────────────────────────────────
# Agentic RAG Engine — Environment Configuration
# ──────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ──────────────────────────────────────────────────────

# === LLM Provider ===
# "ollama" (default, free, local) or "openai"
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# === Embedding Provider ===
# "local" (default, SentenceTransformers) or "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# === OpenAI (optional — only needed if *_PROVIDER=openai) ===
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === FastAPI ===
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# === PostgreSQL (pgvector) ===
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vector_db
# Ou bien URL directe (ex: Neon / Supabase) :
# DATABASE_URL=postgresql://user:password@host:5432/dbname
